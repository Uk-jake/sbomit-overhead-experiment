rm -fr ./dist
mkdir -p ./dist
for os in linux darwin; do \
      for arch in amd64 arm64; do \
        echo "Building Cortex for $os/$arch"; \
        GOOS=$os GOARCH=$arch CGO_ENABLED=0 go build -ldflags "-X main.Branch=master -X main.Revision=d50fcab -X main.Version=1.21.1 -extldflags \"-static\" -s -w" -tags "netgo slicelabels" -o ./dist/cortex-$os-$arch ./cmd/cortex; \
        sha256sum ./dist/cortex-$os-$arch | cut -d ' ' -f 1 > ./dist/cortex-$os-$arch-sha-256; \
        echo "Building query-tee for $os/$arch"; \
        GOOS=$os GOARCH=$arch CGO_ENABLED=0 go build -ldflags "-X main.Branch=master -X main.Revision=d50fcab -X main.Version=1.21.1 -extldflags \"-static\" -s -w" -tags "netgo slicelabels" -o ./dist/query-tee-$os-$arch ./cmd/query-tee; \
        sha256sum ./dist/query-tee-$os-$arch | cut -d ' ' -f 1 > ./dist/query-tee-$os-$arch-sha-256; \
      done; \
    done; \
    touch dist/.uptodate
